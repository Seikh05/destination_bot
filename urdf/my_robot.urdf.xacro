<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== PROPERTIES ===================== -->
  <!-- Change these numbers to resize your robot -->
  <xacro:property name="base_length"   value="0.6"/>
  <xacro:property name="base_width"    value="0.4"/>
  <xacro:property name="base_height"   value="0.2"/>
  <xacro:property name="wheel_radius"  value="0.035"/>
  <xacro:property name="wheel_width"   value="0.025"/>
  <xacro:property name="caster_radius" value="0.035"/>

  <!-- ===================== MATERIALS ===================== -->
  <material name="green"> <color rgba="0 0.6 0 1"/>      </material>
  <material name="black"> <color rgba="0 0 0 1"/>        </material>
  <material name="blue">  <color rgba="0.1 0.4 0.8 1"/>  </material>
  <material name="grey">  <color rgba="0.5 0.5 0.5 1"/>  </material>

  <!-- ===================== BASE FOOTPRINT ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== CHASSIS ===================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <!-- GAZEBO NEEDS THIS: collision shape -->
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
    </collision>
    <!-- GAZEBO NEEDS THIS: mass and inertia -->
    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="${(1.5/12)*(base_width*base_width + base_height*base_height)}"
        ixy="0" ixz="0"
        iyy="${(1.5/12)*(base_length*base_length + base_height*base_height)}"
        iyz="0"
        izz="${(1.5/12)*(base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- ===================== WHEEL MACRO ===================== -->
  <!-- Instead of copy-pasting wheel code twice, we use a macro -->
  <xacro:macro name="wheel" params="name y_reflect">

    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia
          ixx="${(0.1/12)*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0" ixz="0"
          iyy="${(0.1/12)*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0"
          izz="${(0.1/2)*wheel_radius*wheel_radius}"/>
      </inertial>
    </link>

    <joint name="base_${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="-0.15 ${y_reflect*(base_width/2 + 0.005)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- Call the macro for left and right -->
  <xacro:wheel name="left"  y_reflect=" 1"/>
  <xacro:wheel name="right" y_reflect="-1"/>

  <!-- ===================== FRONT CASTER ===================== -->
  <link name="front_caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="${(2.0/5)*0.05*caster_radius*caster_radius}" ixy="0" ixz="0"
        iyy="${(2.0/5)*0.05*caster_radius*caster_radius}" iyz="0"
        izz="${(2.0/5)*0.05*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_caster"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.10 0 ${base_height + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== GAZEBO PLUGINS ===================== -->

  <!-- Plugin 1: Differential Drive (makes robot move with cmd_vel) -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>base_left_wheel_joint</left_joint>
      <right_joint>base_right_wheel_joint</right_joint>
      <wheel_separation>0.455</wheel_separation>
      <wheel_diameter>0.07</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- Plugin 2: Lidar Sensor (publishes /scan for SLAM) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <!-- AFTER — full 360° guaranteed -->
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159265</min_angle>
          <max_angle> 3.14159265</max_angle>
        </horizontal>
      </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Caster wheel friction = 0 so it slides freely -->
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

</robot>