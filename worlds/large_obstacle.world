<?xml version="1.0"?>
<sdf version="1.6">
  <world name="big_obstacle_world">

    <!-- ===== LIGHTING ===== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include><uri>model://ground_plane</uri></include>

    <!-- =====================================================
         BOUNDARY WALLS  (20m × 20m arena)
         ===================================================== -->

    <!-- North wall -->
    <model name="wall_north"><static>true</static>
      <pose>0 10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south"><static>true</static>
      <pose>0 -10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east"><static>true</static>
      <pose>10 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west"><static>true</static>
      <pose>-10 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 20.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
